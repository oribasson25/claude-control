# ---------------------------------------------------------------------------
# State store
#
# With these unset the app keeps state in a JSON file under
# .claude-control-data/ and runs entirely on your machine. Set them to run on
# Vercel, where serverless functions cannot share memory between requests.
#
# Either naming works, and they hold the same two values. The Vercel Upstash
# Marketplace integration injects the KV_ pair for you; a database created on
# Upstash directly gives you the UPSTASH_ pair, which you paste into Vercel.
# ---------------------------------------------------------------------------
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Browser auth
#
# With no OAuth provider configured the app runs in single-user local mode, and
# refuses to serve from a deployed URL — every visitor would share one namespace.
# ---------------------------------------------------------------------------
# AUTH_SECRET=            # openssl rand -base64 32
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Only if the deployed URL is genuinely private and you want local mode anyway.
# ALLOW_LOCAL_MODE=1

# Reject any hook event that does not carry a valid HMAC signature.
# REQUIRE_HOOK_SIGNATURE=1

# Where the local file backend keeps its data. Defaults to ./.claude-control-data
# CLAUDE_CONTROL_DATA_DIR=
